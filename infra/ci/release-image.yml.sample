# MẪU workflow (không chạy được từ đây; đặt vào .github/workflows/ bởi người có quyền). EC-OPS04.
# Chỉ build linux/amd64, KHÔNG push — thêm bước push/deploy sau khi người duyệt.
name: release-image
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build-amd64:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - name: Build (amd64, không push)
        run: docker buildx build --platform linux/amd64 -f backend/Dockerfile backend -t vayshield-backend:ci
      - name: gitleaks
        run: |
          docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:latest detect --source /repo --config /repo/.gitleaks.toml --no-banner
