# Mẫu biến môi trường (GIÁ TRỊ GIẢ). Sao chép thành infra/prod.env (không commit) rồi điền giá trị thật.
# Tên biến khớp backend/app/core/config.py. Bản .zip nộp bài chỉ chứa file mẫu này / .env.example (EC-OPS01).
# Khóa chạy trực tuyến lưu ở Cloud Secret Manager, không nằm trong repo.

APP_ENV=production
PUBLIC_DOMAIN=demo.example.invalid
CORS_ORIGINS=https://demo.example.invalid

DB_ADMIN_PASSWORD=change-me-admin
DB_PASSWORD=change-me-app

# base64 32 byte mỗi khóa (sinh bằng: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
PEPPER_B2B_PHONE=change-me
PEPPER_MULE_ACCOUNT=change-me
KMS_MASTER_KEK=change-me
ED25519_POLICY_PRIVATE_KEY=change-me
JWT_OPS_SECRET=change-me

# Phân tách bằng dấu phẩy. Pool VIP tách riêng khỏi pool công cộng.
GEMINI_API_KEYS=
GEMINI_VIP_KEYS=
SANDBOX_VIP_CODE=

# Proxy tin cậy cho X-Forwarded-For (CIDR/IP, phân tách dấu phẩy). KHÔNG dùng "*".
FORWARDED_ALLOW_IPS=172.28.10.0/24
