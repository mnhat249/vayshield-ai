# Mẫu biến môi trường (GIÁ TRỊ GIẢ). Sao chép thành infra/prod.env (không commit) rồi điền giá trị thật,
# sau đó chạy:  python infra/scripts/preflight.py infra/prod.env
# Tên biến khớp backend/app/core/config.py. Bản .zip nộp bài chỉ chứa file mẫu này (EC-OPS01).
# Khóa chạy trực tuyến lưu ở Cloud Secret Manager, không nằm trong repo.

APP_ENV=production
PUBLIC_DOMAIN=demo.example.invalid
CORS_ORIGINS=https://demo.example.invalid

DB_ADMIN_PASSWORD=change-me-admin
DB_PASSWORD=change-me-app
# Chỉ gồm [A-Za-z0-9] (nằm trong REDIS_URL).
REDIS_PASSWORD=change-me

# ED25519_POLICY_PRIVATE_KEY, KMS_MASTER_KEK: base64 của đúng 32 byte ngẫu nhiên
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Peppers, JWT_OPS_SECRET: chuỗi ngẫu nhiên >= 32 byte (cùng lệnh trên là đủ).
PEPPER_B2B_PHONE=change-me
PEPPER_MULE_ACCOUNT=change-me
KMS_MASTER_KEK=change-me
ED25519_POLICY_PRIVATE_KEY=change-me
JWT_OPS_SECRET=change-me

# ---- Tùy chọn. Hậu quả khi để trống ghi ngay bên dưới ----
# Pool khóa Gemini (phân tách dấu phẩy). Trống = không gọi được AI thật (chỉ mock/lỗi degrade).
GEMINI_API_KEYS=
# Pool VIP riêng cho giám khảo. Trống = phiên JUDGE_VIP dùng chung hạn mức/không có lane riêng.
GEMINI_VIP_KEYS=
# Mã ?vip= trên tờ A4. Trống = không có phiên JUDGE_VIP.
SANDBOX_VIP_CODE=
# Mã đăng nhập nhanh Fraud Ops cho giám khảo, >= 16 ký tự. Trống hoặc ngắn hơn = TẮT đăng nhập nhanh.
JUDGE_OPS_QUICK_LOGIN_CODE=
# Web Push VAPID. Trống = không gửi được Web Push tới người thân (rơi về SMS nếu có).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.invalid
# SMS fallback. fake = không gửi SMS thật: leo thang Zero-Amount chỉ còn WS/Push.
SMS_PROVIDER=fake
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=VAYSHIELD

# Proxy tin cậy cho X-Forwarded-For. Compose prod đã cố định IP Caddy. KHÔNG dùng "*".
FORWARDED_ALLOW_IPS=172.28.10.2
